<mujoco model="boston_round_bottle">
  <compiler angle="radian" meshdir="." />

  <asset>
    <mesh name="bottle_mesh" file="bottle.obj" />
    <material name="bottle_mat" rgba="0.92 0.94 0.96 0.9" specular="0.6" shininess="0.5" />
    <material name="collision_mat" rgba="0.2 0.8 0.2 0.0" />
  </asset>

  <default>
    <!-- Bottle friction: sliding (1.2), torsional (0.005), rolling (0.0001) for robust grasp -->
    <default class="bottle_collision">
      <geom contype="1" conaffinity="1" condim="4" friction="1.2 0.005 0.0001" material="collision_mat" />
    </default>
  </default>

  <worldbody>
    <body name="bottle" pos="0 0 0">
      <!-- Freejoint allows the bottle to move freely in 3D space -->
      <freejoint name="bottle_joint" />

      <!-- Center of Mass: ~0.075m height for 150g plastic bottle -->
      <inertial pos="0 0 0.075" mass="0.15" diaginertia="0.0004 0.0004 0.00015" />

      <!-- 1. Visual Geometry: High-resolution OBJ Mesh (contype=0 conaffinity=0: no physics collision) -->
      <geom name="bottle_visual" type="mesh" mesh="bottle_mesh" class="bottle_collision" 
            contype="0" conaffinity="0" group="1" material="bottle_mat" />

      <!-- 2. Collision Geometries: Analytical Primitives (Perfect for stable gripping & slip detection) -->
      <!-- Main cylindrical body (radius 0.033m, half-height 0.055m, centered at z=0.058m) -->
      <geom name="bottle_body_col" class="bottle_collision" type="cylinder" 
            pos="0 0 0.058" size="0.033 0.055" group="0" />
      
      <!-- Shoulder transition cap -->
      <geom name="bottle_shoulder_col" class="bottle_collision" type="cylinder" 
            pos="0 0 0.125" size="0.024 0.015" group="0" />

      <!-- Neck & Cap (radius 0.0155m, half-height 0.0175m, centered at z=0.1575m) -->
      <geom name="bottle_cap_col" class="bottle_collision" type="cylinder" 
            pos="0 0 0.1575" size="0.0155 0.0175" group="0" />

    </body>
  </worldbody>
</mujoco>
